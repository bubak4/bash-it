.atom-build.json
*/enabled/*
.DS_Store
custom/*
!custom/example.bash
.rvmrc
aliases/custom.aliases.bash
completion/custom.completion.bash
lib/custom.bash
plugins/custom.plugins.bash
*.swp
.*.un~
bats
.idea
*.sublime-workspace
*.sublime-project
enabled/*
/enabled
tmp/

# Do not save profiles
profiles/*
# apart from the default one
!profiles/default.bash_it

/vendor/github.com/nojhan/liquidprompt
.trunk/
config/etc/.netrc
config/etc/.netrc.notes
config/etc/.netrc.bak

# python bytecode (config/accounts)
*.pyc
__pycache__/

# account data -- never tracked, not even encrypted. Distributed between
# hosts by config/bin/lan/sync-with-lan.sh instead. The matching
# filter=git-crypt lines in .gitattributes stay as a safety net, so an
# accidental `git add -f` encrypts rather than commits in the clear.
config/accounts/accounts.xml
config/accounts/internet_registrace.txt
# generated per-host by config/install.sh
config/.install-secret
