#!/usr/bin/env python3
"""Exec-credential provider for vSphere with Tanzu clusters.

kubectl-vsphere has no get-token subcommand and does not speak the
ExecCredential protocol -- login/logout/version/vm is the whole of it, and
login only knows how to write out an entire kubeconfig. This bridges the two,
so a vSphere cluster can live in a static kubeconfig like every other cluster
and kubectl refreshes the token on its own.

Invoked by kubectl through the exec block of ~/.kube/<name>-config.yaml; see
kube-vsphere.bash for the wiring.

The password comes from gnome-keyring, which the desktop session unlocks, so
nothing is ever typed.

The issued token is good for ten hours, but client-go holds exec results in
memory for the life of one command only. Without a cache of our own, every
single kubectl invocation would mean a fresh vCenter login -- seconds of
latency each time, and a pile of sessions. The cache is what makes this
usable rather than merely correct.
"""

import argparse
import base64
import errno
import fcntl
import json
import os
import subprocess
import sys
import tempfile
import time

API_VERSION = "client.authentication.k8s.io/v1"

# Re-login this long before the token actually lapses, so a command started at
# the boundary does not race the expiry it just checked.
REFRESH_SKEW = 300


def log(message):
    """Progress goes to stderr -- stdout carries the protocol and nothing else."""
    print("kubectl-vsphere-credential: %s" % message, file=sys.stderr)


def token_expiry(token):
    """Seconds-since-epoch out of the JWT's exp claim."""
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    return int(json.loads(base64.urlsafe_b64decode(payload))["exp"])


def read_cache(path):
    """The cached credential if it is still comfortably valid, else None."""
    try:
        with open(path) as handle:
            cached = json.load(handle)
    except (OSError, ValueError):
        return None

    if cached.get("expiry", 0) - time.time() < REFRESH_SKEW:
        return None

    return cached


def write_cache(path, cached):
    """Replace the cache atomically, so a reader never sees a half-written file."""
    directory = os.path.dirname(path)
    handle, temporary = tempfile.mkstemp(dir=directory)

    try:
        with os.fdopen(handle, "w") as stream:
            json.dump(cached, stream)
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except Exception:
        os.unlink(temporary)
        raise


def attributes(args):
    """How the password is addressed in the keyring. There are no paths in the
    Secret Service, only attributes, so `service` does the grouping that a
    directory would do elsewhere: `secret-tool search --all service vsphere`
    lists every vSphere password stored this way."""
    return ["service", "vsphere", "server", args.server, "username", args.username]


def password(args):
    """The password out of gnome-keyring. The login keyring is unlocked by the
    desktop session, so this is silent -- no prompt, no GPG. secret-tool prints
    the secret with no trailing newline, so it is used exactly as it comes."""
    attrs = attributes(args)
    result = subprocess.run(
        ["secret-tool", "lookup"] + attrs, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )

    if result.returncode != 0 or not result.stdout:
        # The label is only what seahorse displays -- the lookup above matches on
        # the attributes alone, so naming the cluster in it costs nothing.
        label = "vSphere %s (%s)" % (args.cluster, args.username)
        log("no password in gnome-keyring for %s at %s" % (args.username, args.server))
        log("store it with:")
        log("  secret-tool store --label=%r %s" % (label, " ".join(attrs)))
        sys.exit(1)

    return result.stdout.decode()


def login(args, directory):
    """Run the plugin against a throwaway kubeconfig and hand back what it
    wrote. The password goes over the one channel the plugin offers, and lives
    only in this child process's environment."""
    # Fetch the password before creating anything: a missing keyring item exits
    # here, and a temporary file made first would be left behind.
    environment = dict(os.environ)
    environment["KUBECTL_VSPHERE_PASSWORD"] = password(args)

    handle, kubeconfig = tempfile.mkstemp(dir=directory, suffix=".yaml")
    os.close(handle)
    environment["KUBECONFIG"] = kubeconfig

    try:
        # The plugin is chatty on stdout; send that to stderr so it cannot
        # corrupt the JSON kubectl is parsing.
        result = subprocess.run(
            [
                "kubectl", "vsphere", "login",
                "--server", args.server,
                "--vsphere-username", args.username,
                "--tanzu-kubernetes-cluster-namespace", args.namespace,
                "--tanzu-kubernetes-cluster-name", args.cluster,
            ] + (["--insecure-skip-tls-verify"] if args.insecure else []),
            env=environment,
            stdout=sys.stderr.fileno(),
        )

        if result.returncode != 0:
            log("vsphere login failed")
            sys.exit(1)

        view = subprocess.run(
            ["kubectl", "--kubeconfig", kubeconfig, "config", "view", "--raw", "-o", "json"],
            stdout=subprocess.PIPE,
            check=True,
        )
        config = json.loads(view.stdout)
    finally:
        os.unlink(kubeconfig)

    return config


def current_entries(config):
    """The cluster and user behind the kubeconfig's current context. The login
    leaves the requested Tanzu cluster selected, so this is the guest cluster
    rather than the supervisor entry it also writes."""
    current = config.get("current-context")
    context = next(
        (c["context"] for c in config.get("contexts") or [] if c["name"] == current), None
    )

    if context is None:
        log("the plugin wrote no usable context (current: %s)" % current)
        sys.exit(1)

    cluster = next(
        (c for c in config.get("clusters") or [] if c["name"] == context["cluster"]), None
    )
    user = next(
        (u for u in config.get("users") or [] if u["name"] == context["user"]), None
    )

    return cluster, user


def credential(config):
    """The bearer token out of a freshly written kubeconfig."""
    _, user = current_entries(config)
    token = (user or {}).get("user", {}).get("token")

    if not token:
        log("no token in the kubeconfig the plugin wrote")
        sys.exit(1)

    return {"token": token, "expiry": token_expiry(token)}


def bootstrap(args, config, path, cache):
    """Write the static kubeconfig that points back at this command, so the
    cluster needs no further logins of its own. Run once per cluster -- and
    again only if the cluster's CA changes."""
    cluster, _ = current_entries(config)

    document = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [cluster],
        "users": [{"name": args.name, "user": {"exec": {
            "apiVersion": API_VERSION,
            "command": os.path.basename(sys.argv[0]),
            "args": [
                "--server", args.server,
                "--username", args.username,
                "--namespace", args.namespace,
                "--cluster", args.cluster,
            ] + (["--insecure"] if args.insecure else []),
            "interactiveMode": "IfAvailable",
        }}}],
        "contexts": [{"name": args.cluster,
                      "context": {"cluster": cluster["name"], "user": args.name}}],
        "current-context": args.cluster,
    }

    handle, temporary = tempfile.mkstemp(dir=os.path.dirname(path))
    with os.fdopen(handle, "w") as stream:
        json.dump(document, stream, indent=2)  # JSON is valid YAML
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)

    # The login that just happened is a perfectly good token -- keep it, so the
    # first kubectl against the new config does not open a second session.
    write_cache(cache, credential(config))

    log("wrote %s" % path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--server", required=True, help="supervisor API endpoint")
    parser.add_argument("--username", required=True, help="vSphere username")
    parser.add_argument("--namespace", required=True, help="supervisor namespace")
    parser.add_argument("--cluster", required=True, help="Tanzu cluster name")
    parser.add_argument("--insecure", action="store_true", help="skip TLS verification")
    parser.add_argument("--bootstrap", metavar="PATH",
                        help="log in once and write the static kubeconfig to PATH")
    parser.add_argument("--name", default="vsphere",
                        help="short cluster name, used inside a bootstrapped kubeconfig")
    args = parser.parse_args()

    directory = os.path.join(os.path.expanduser("~"), ".kube", "credential-cache")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    cache = os.path.join(directory, "vsphere-%s-%s.json" % (args.namespace, args.cluster))

    if args.bootstrap:
        bootstrap(args, login(args, directory), args.bootstrap, cache)
        return

    cached = read_cache(cache)

    if cached is None:
        # Serialise the refresh: several kubectl commands starting at once
        # would otherwise each open their own vCenter session.
        with open(cache + ".lock", "a") as lock:
            os.fchmod(lock.fileno(), 0o600)
            fcntl.flock(lock, fcntl.LOCK_EX)

            # Whoever held the lock has very likely just refreshed it.
            cached = read_cache(cache)
            if cached is None:
                log("token expired, logging in to %s" % args.cluster)
                cached = credential(login(args, directory))
                write_cache(cache, cached)

    json.dump(
        {
            "apiVersion": API_VERSION,
            "kind": "ExecCredential",
            "status": {
                "token": cached["token"],
                "expirationTimestamp": time.strftime(
                    "%Y-%m-%dT%H:%M:%SZ", time.gmtime(cached["expiry"])
                ),
            },
        },
        sys.stdout,
    )
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except OSError as error:
        if error.errno == errno.EPIPE:
            sys.exit(0)
        raise
